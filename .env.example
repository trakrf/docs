# Build target: "production" or "preview". Drives docusaurus url + customFields,
# which determines whether SSR/sitemap/canonical/Redocusaurus emit *.trakrf.id
# or *.preview.trakrf.id URLs. Auto-detected from CF_PAGES_BRANCH on Cloudflare
# Pages (main → production). Local dev defaults to "preview" so prod URLs are
# not emitted by accident.
DEPLOY_ENV=preview

# App-tour screenshots are captured against platform running locally, not preview —
# local dev renders without the purple environment banner, so the app looks like
# production. See docs/app-tour/authoring.md for the full capture workflow.
TRAKRF_LOCAL_URL=http://localhost:5173

# Credentials for the "TrakRF Docs" org used for screenshot capture. Leave blank
# on first run; sign up through the local UI (creating an org named exactly
# "TrakRF Docs"), then fill these in and run scripts/seed-docs-org.sql.
TRAKRF_DOCS_USER_EMAIL=
TRAKRF_DOCS_USER_PASSWORD=

# Path to your trakrf/infra checkout, used by the `just ops` passthrough.
# The sibling-directory fallback assumes ~/infra; set this if yours differs
# (e.g. ~/trakrf-infra). .envrc loads .env.local.
# TRAKRF_INFRA_DIR=/home/you/trakrf-infra
